<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.iflytek.sample.view"
    android:versionCode="3"
    android:versionName="3.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="22" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="VoiceKey"
        android:allowBackup="false">

        <activity
            android:name="com.iflytek.sample.view.MainActivity"
            android:label="VoiceKey"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Input method: receives vendor keycode 4113 from the remote and dictates. -->
        <service
            android:name="com.iflytek.sample.view.VkImeService"
            android:label="VoiceKey"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          Stands in for iFlytek's demo voice-view client. xiri binds
          "com.iflytek.xiri.voice.VIEW" implicitly whenever this package is installed,
          so every recognised string reaches us before being proxied to com.tcl.walleve.
        -->
        <service
            android:name="com.iflytek.sample.view.RelayService"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="com.iflytek.xiri.voice.VIEW" />
            </intent-filter>
        </service>
    </application>
</manifest>
